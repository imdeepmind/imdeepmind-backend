# Server bind settings used by `npm run dev` / `./dev.sh local`.
HOST=0.0.0.0
PORT=4001

# Postgres credentials used by docker compose.
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=imdeepmind

# Connection string used by `npm run dev` when Postgres runs in Docker.
# (The api container gets its own DATABASE_URL pointing at the `db` service.)
DATABASE_URL=postgresql://devuser:devpassword@localhost:5433/imdeepmind
