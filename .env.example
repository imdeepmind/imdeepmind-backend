# Server bind settings used by `npm run dev` / `./dev.sh local`.
HOST=0.0.0.0
PORT=4001

# Connection string used by `npm run dev` when Postgres runs in Docker.
# (The api container gets its own DATABASE_URL pointing at the `db` service.)
DATABASE_URL=postgresql://devuser:devpassword@localhost:5433/imdeepmind

# Secret used to sign auth JWTs. Must be at least 32 characters.
# Generate a unique value for any deployed environment.
JWT_SECRET=dev-only-jwt-secret-change-me-in-production

# AWS SES email integration.
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@example.com
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
