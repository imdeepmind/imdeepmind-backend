{
  "name": "imdeepmind-backend",
  "version": "0.1.0",
  "description": "Backend API for all my personal projects",
  "type": "module",
  "main": "build/main.js",
  "types": "build/main.d.ts",
  "files": [
    "build"
  ],
  "license": "Apache-2.0",
  "keywords": [],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
